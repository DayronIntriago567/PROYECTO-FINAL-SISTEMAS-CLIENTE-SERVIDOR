@model List<BikeStore.Web.Models.Bicicleta>

@{
    ViewData["Title"] = "Stock bajo";
}

<h1>Bicicletas con stock bajo</h1>
<p class="text-muted">Se muestran bicicletas con stock mayor a 0 y menor o igual a 5 unidades.</p>

<table class="table">
    <thead>
        <tr>
            <th>Marca</th>
            <th>Modelo</th>
            <th>Categoria</th>
            <th>Stock</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var b in Model)
        {
            <tr class="table-warning">
                <td>@b.Marca</td>
                <td>@b.Modelo</td>
                <td>@b.Categoria?.Nombre</td>
                <td>@b.Stock</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-link">Volver</a>
