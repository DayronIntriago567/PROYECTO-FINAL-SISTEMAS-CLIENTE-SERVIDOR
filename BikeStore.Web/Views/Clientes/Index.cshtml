@model List<BikeStore.Web.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<h1>Clientes</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">Nuevo cliente</a>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Cedula</th>
            <th>Nombres</th>
            <th>Apellidos</th>
            <th>Telefono</th>
            <th>Correo</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Cedula</td>
                <td>@c.Nombres</td>
                <td>@c.Apellidos</td>
                <td>@c.Telefono</td>
                <td>@c.Correo</td>
            </tr>
        }
    </tbody>
</table>
